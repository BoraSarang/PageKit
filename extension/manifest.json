{
  "manifest_version": 3,
  "name": "PageKit (페이지킷)",
  "version": "1.0.11",
  "description": "웹페이지 군더더기는 빼고, 알짜배기 미디어만 쏙! 본문을 분석하고 이미지·동영상·링크를 정리하는 스마트 웹 툴킷",
  "default_locale": "ko",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "contextMenus",
    "commands",
    "scripting",
    "activeTab",
    "webRequest",
    "declarativeNetRequest",
    "notifications"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PageKit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "pagekit-open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "PageKit 사이드 패널 열기"
    },
    "pagekit-toggle-debug": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "PageKit 디버그 창 열기/닫기"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'; img-src 'self' https: data: blob:"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "debug.js",
        "content/extractor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}